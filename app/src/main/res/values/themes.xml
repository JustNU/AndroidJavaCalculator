<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.AndroidJavaCalculator" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:backgroundTint">@color/themeWhite</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="Theme.AndroidJavaCalculator" parent="Base.Theme.AndroidJavaCalculator" />

    <style name="Theme.AndroidJavaCalculator.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="Theme.AndroidJavaCalculator.AppBarOverlay" parent="ThemeOverlay.AppCompat.Dark.ActionBar" />

    <style name="Theme.AndroidJavaCalculator.PopupOverlay" parent="ThemeOverlay.AppCompat.Light" />
</resources>